PORT=3001
JWT_SECRET=change-me-to-a-secure-random-string
JWT_EXPIRES_IN=7d

# MongoDB connection URI
# Local MongoDB: mongodb://localhost:27017/voice-app
# MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/voice-app
MONGODB_URI=mongodb://localhost:27017/voice-app

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Frontend URL for redirects
FRONTEND_URL=http://localhost:8080

# Comma-separated list of origins allowed by CORS (optional)
# Example: CORS_ORIGINS=http://localhost:8080,http://localhost:5173
CORS_ORIGINS=
